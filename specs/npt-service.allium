-- Scope: what NPT delivers, independent of who is looking at it.
-- Excludes: timing architecture, provider operations, the consumer boundary.

use "./npt-timing.allium" as timing

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

external entity NetworkZone {
    name: String
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity Site {
    zone: NetworkZone
    name: String

    synchronisation: Synchronisation with site = this
}

entity MajorSite {
    name: String

    supplies: StratumOneSupply with major_site = this
}

entity StratumOneSupply {
    major_site: MajorSite
    time_scale: timing/LocalTimeScale
    status: pending | available | degraded | withdrawn
    indicated_quality: timing/QualityIndication
}

entity Synchronisation {
    site: Site
    status: requested | designed | operational | ceased

    sources: SynchronisationSource with synchronisation = this

    zone: site.zone
    source_count: sources.count
}

-- Redundancy is a property of the use, not of the supply.
entity SynchronisationSource {
    synchronisation: Synchronisation
    supply: StratumOneSupply
    role: primary | secondary
}

-- Confirmed and unattributed is a real resting place, not a failure to
-- finish investigating.
entity Ticket {
    zone: NetworkZone
    service: Synchronisation
    concern: output_incorrect | indication_incorrect
    raised: timing/Stamp
    status: received | investigating | upheld | unattributed | dismissed

    divergence: timing/Divergence?
    implicated_supply: StratumOneSupply?

    invariant UpheldNamesASupply {
        status = upheld implies implicated_supply != null
    }

    invariant UnattributedNamesNoSupply {
        status = unattributed implies implicated_supply = null
    }
}

entity ServiceEvent {
    service: Synchronisation
    event_type: String
    occurred: timing/Stamp
}

------------------------------------------------------------
-- Deferred Specifications
------------------------------------------------------------

-- Restating asserted quality over a past window, when the timebase that
-- stamped the record is the one found wanting.
deferred QualityHistory.restate    -- see: detailed/npt-quality-history.allium

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "Does NPT govern a tenant lifecycle, or is NetworkZone wholly external?"
open question "Does NPT model the stratum 2 clock, or end at the site demarcation?"
open question "Is availability redundancy (two supplies) specified separately from attribution redundancy (three witnesses)?"
open question "Must a service's two sources be at different major sites?"
open question "Does a Synchronisation enter holdover, and is holdover tracked?"
open question "Do navigation and positioning share this tenancy model?"
open question "Unify timing/SourceQualityFinding and Ticket, or keep the boundaries separate?"
