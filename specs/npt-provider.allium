-- allium: 3
--
-- SPDX-FileCopyrightText: 2025 diffo_example contributors <https://github.com/diffo-dev/diffo_example/graphs.contributors>
--
-- SPDX-License-Identifier: MIT

-- Scope: what NPT does inside its own boundary. Investigation, attribution,
--   and disclosure.
-- Excludes: the model itself, timing architecture, the consumer boundary.

use "./npt-service.allium" as npt
use "./npt-timing.allium" as timing

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- Whoever acts on NPT's behalf. Attribution decisions are answerable, so the
-- actor is recorded rather than implied.
entity Operator {
    name: String
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule NptBeginsInvestigation {
    when: NptBeginsInvestigation(operator, ticket)

    requires: ticket.status = received

    ensures: ticket.status = investigating
}

rule NptDismissesTicket {
    when: NptDismissesTicket(operator, ticket)

    requires: ticket.status = investigating

    ensures: ticket.status = dismissed
}

-- Attribution is earned, not asserted.
rule NptAttributesDivergence {
    when: NptAttributesDivergence(operator, divergence, timebase)

    requires: divergence.status = detected
    requires: divergence.attributable

    ensures:
        divergence.status = attributed
        divergence.implicated = timebase
}

-- The witnesses do not support naming anyone. The divergence is still real.
rule NptCannotAttributeDivergence {
    when: NptCannotAttributeDivergence(operator, divergence)

    requires: divergence.status = detected
    requires: not divergence.attributable

    ensures:
        divergence.status = unattributed
        divergence.implicated = null
}

rule NptUpholdsTicket {
    when: NptUpholdsTicket(operator, ticket, supply, divergence)

    requires: ticket.status = investigating
    requires: divergence.status = attributed

    ensures:
        ticket.status = upheld
        ticket.divergence = divergence
        ticket.implicated_supply = supply
        SupplyIndicationRevised(supply: supply, ticket: ticket)
}

-- The zone was right and NPT still cannot say whose clock was wrong.
rule NptUpholdsWithoutAttribution {
    when: NptUpholdsWithoutAttribution(operator, ticket, divergence)

    requires: ticket.status = investigating
    requires: divergence.status = unattributed

    ensures:
        ticket.status = unattributed
        ticket.divergence = divergence
}

-- The finding is about the supply, so every zone drawing on it is told.
rule PropagateRevisedIndication {
    when: SupplyIndicationRevised(supply, ticket)

    for service in npt/Synchronisations where sources.any(s => s.supply = supply):
        ensures: npt/ServiceEvent.created(
            service: service,
            event_type: "qualityIndicationRevised",
            occurred: ticket.raised
        )
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor NptOperations {
    identified_by: Operator where name != null
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface TicketInvestigation {
    facing operator: NptOperations

    context ticket: npt/Ticket

    exposes:
        ticket.concern
        ticket.raised
        ticket.service.site.name
        ticket.divergence.status

    provides:
        NptBeginsInvestigation(operator, ticket)
        NptUpholdsTicket(operator, ticket, supply, divergence)
        NptUpholdsWithoutAttribution(operator, ticket, divergence)
        NptDismissesTicket(operator, ticket)

    @guarantee NoAttributionWithoutWitnesses
        -- Upholding against a named supply requires an attributed divergence.
}

surface DivergenceAttribution {
    facing operator: NptOperations

    context divergence: timing/Divergence

    exposes:
        divergence.detected
        divergence.witness_count
        divergence.attributable

    provides:
        NptAttributesDivergence(operator, divergence, timebase)
        NptCannotAttributeDivergence(operator, divergence)

    @guarantee UnattributedIsTerminal
        -- Failing to attribute is an outcome, not a pending state.
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "Can NPT dismiss a Ticket unilaterally?"
open question "What drives a Ticket from received to resolution - staff, automated assessment, or both?"
open question "Does a Ticket ever propagate outward as a timing/SourceQualityFinding?"
open question "Is Operator a person, an agent, or either?"
